NODE_ENV=production
PORT=4000
APP_URL=https://staging.upnext.works
API_URL=https://api-staging.upnext.works
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres-staging:5432/<POSTGRES_DB>?schema=public
JWT_SECRET=<STRONG_STAGING_JWT_SECRET>
JWT_REFRESH_SECRET=<STRONG_STAGING_REFRESH_SECRET>
# Keep `gemini` until ai-staging reports healthy. Once it is healthy, route every
# recruiter AI capability through the same private service rather than leaving
# salary research on a separate, direct Gemini path.
AI_LLM_PROVIDER=gemini
AI_JOB_POST_GENERATION_PROVIDER=gemini
AI_JOB_POST_EXTRACTION_PROVIDER=gemini
AI_GROUNDED_RESEARCH_PROVIDER=gemini
AI_SERVICE_URL=http://ai-staging:8000
# Must exactly match env/ai.staging.env. Never reuse JWT_ACCESS_SECRET here.
AI_INTERNAL_JWT_SECRET=<strong-random-secret-shared-only-with-ai-staging>
AI_SERVICE_TIMEOUT_MS=25000
AI_SERVICE_FALLBACK_TO_GEMINI=true
# Grounded salary research performs several web searches and needs its own budget.
AI_GROUNDED_RESEARCH_SERVICE_TIMEOUT_MS=75000
# When the private service is selected, keep failures explicit. A fallback to direct
# Gemini can silently reintroduce the VPS region limitation and double the request cost.
AI_JOB_POST_GENERATION_FALLBACK_TO_GEMINI=false
AI_JOB_POST_EXTRACTION_FALLBACK_TO_GEMINI=false
AI_GROUNDED_RESEARCH_FALLBACK_TO_GEMINI=false
CORS_ORIGIN=https://staging.upnext.works
