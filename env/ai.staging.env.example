# Private upnext-ai configuration. This file is mounted only into ai-staging;
# do not copy it into frontend or expose it through Nginx.
AI_ENVIRONMENT=staging
AI_INTERNAL_JWT_SECRET=<strong-random-secret-shared-only-with-backend-staging>
AI_INTERNAL_JWT_ISSUER=upnext-be
AI_INTERNAL_JWT_AUDIENCE=upnext-ai
AI_INTERNAL_JWT_MAX_TTL_SECONDS=90
GEMINI_API_KEY=<gemini-api-key>
AI_STRUCTURED_MODEL=gemini-2.5-flash-lite
AI_TEXT_MODEL=gemini-2.5-flash
AI_STRUCTURED_TIMEOUT_SECONDS=15
AI_STREAM_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
