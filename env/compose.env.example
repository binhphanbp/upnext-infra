# Docker Compose interpolation and project identity for the live VPS.
#
# Keep `upnext` while the existing production and staging containers share that
# namespace. Changing this value without a planned container/volume migration
# creates a second stack rather than updating the running one.
COMPOSE_PROJECT_NAME=upnext
GITHUB_OWNER=<GITHUB_OWNER>

FRONTEND_IMAGE_TAG=production
BACKEND_IMAGE_TAG=production
FRONTEND_STAGING_IMAGE_TAG=staging
BACKEND_STAGING_IMAGE_TAG=staging
AI_STAGING_IMAGE_TAG=develop

N8N_IMAGE_TAG=latest
UPTIME_KUMA_IMAGE_TAG=2
BESZEL_IMAGE_TAG=latest
BESZEL_AGENT_IMAGE_TAG=latest
BESZEL_AGENT_KEY=<BESZEL_AGENT_PUBLIC_KEY_FROM_HUB>
